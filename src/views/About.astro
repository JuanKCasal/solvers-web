---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { img } from '../data/images';
import { ROUTES, route, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';
import { SITE } from '../config/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const es = lang === 'es';

const c = es
  ? {
      title: 'Nosotros',
      description: 'Conozca a Solvers Industriales, C.A.: empresa venezolana de ingeniería mecánica, metalmecánica, eléctrica y civil con un equipo de 15 a 30 años de experiencia en Oil & Gas e hidrológico.',
      lead: 'Empresa venezolana de ingeniería mecánica, metalmecánica, eléctrica y civil.',
      whoTitle: 'Quiénes somos',
      who: [
        'Somos una empresa venezolana que presta servicios de ingeniería mecánica, metalmecánica, eléctrica y civil, respaldada por un equipo con 15 a 30 años de experiencia en los sectores de petróleo y gas e hidrológico.',
        'Nuestros profesionales altamente calificados aportan un profundo conocimiento técnico que nos permite ofrecer soluciones de valor agregado para proyectos de inversión de capital.',
        'Desde hace más de seis años atendemos a clientes de distintos sectores económicos en todo el país.',
      ],
      visionTitle: 'Visión',
      vision: 'Ser una empresa líder en la ejecución de ingeniería mecánica, eléctrica y civil, reconocida a nivel nacional por su rentabilidad y por su capacidad de transformar los retos técnicos de sus clientes en soluciones eficientes, socialmente responsables y amigables con el ambiente.',
      sectorsTitle: 'Sectores que atendemos',
      sectors: [
        { icon: 'flame', name: 'Petróleo y gas', text: 'PDVSA: refinería, plantas de suministro de combustible y líneas de proceso.' },
        { icon: 'gear', name: 'Petroquímica', text: 'Pequiven.' },
        { icon: 'building', name: 'Agua (hidrológico)', text: 'Hidroven e HidroCaribe: plantas potabilizadoras e infraestructura.' },
        { icon: 'truck', name: 'Transporte', text: 'Empresa Nacional de Transporte.' },
      ],
      clientsTitle: 'Clientes',
      clientsText: 'Algunas de las empresas a las que hemos prestado servicios:',
      letterTitle: 'Mensaje del presidente',
      letter: 'Hemos resumido nuestra experiencia de más de seis años prestando servicios de ingeniería mecánica, metalmecánica, eléctrica y civil a distintos sectores económicos del país. Toda la información presentada puede ser verificada cuando usted lo considere conveniente. Nos complacerá establecer una relación comercial con su empresa.',
      role: 'Presidente',
    }
  : {
      title: 'About us',
      description: 'Meet Solvers Industriales, C.A.: a Venezuelan mechanical, metalworking, electrical and civil engineering company with a team of 15 to 30 years of experience in oil & gas and water.',
      lead: 'A Venezuelan mechanical, metalworking, electrical and civil engineering company.',
      whoTitle: 'Who we are',
      who: [
        'We are a Venezuelan company providing mechanical, metalworking, electrical and civil engineering services, backed by a team with 15 to 30 years of experience in the oil & gas and water sectors.',
        'Our highly skilled professionals bring deep technical expertise, enabling us to deliver value-added solutions for capital investment projects.',
        'For more than six years we have served clients from different economic sectors across the country.',
      ],
      visionTitle: 'Vision',
      vision: 'To become a leading company in mechanical, electrical and civil engineering execution, nationally recognized for profitability and for our ability to turn our clients’ technical challenges into efficient, socially responsible and environmentally friendly solutions.',
      sectorsTitle: 'Sectors we serve',
      sectors: [
        { icon: 'flame', name: 'Oil & gas', text: 'PDVSA: refinery, fuel supply plants and process lines.' },
        { icon: 'gear', name: 'Petrochemicals', text: 'Pequiven.' },
        { icon: 'building', name: 'Water', text: 'Hidroven and HidroCaribe: water treatment plants and infrastructure.' },
        { icon: 'truck', name: 'Transport', text: 'Empresa Nacional de Transporte.' },
      ],
      clientsTitle: 'Clients',
      clientsText: 'Some of the companies we have worked for:',
      letterTitle: 'A message from our President',
      letter: 'We have summarized our more than six years of experience providing mechanical, metalworking, electrical and civil engineering services to different economic sectors across the country. All the information presented may be verified at your convenience. We look forward to establishing a business relationship with your company.',
      role: 'President',
    };
---
<BaseLayout lang={lang} title={c.title} description={c.description} alternates={ROUTES.about}>
  <PageHero lang={lang} title={c.title} lead={c.lead} crumbs={[{ label: c.title }]} />

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Solvers Industriales, C.A.</p>
        <h2>{c.whoTitle}</h2>
        <div class="prose">{c.who.map((p) => <p>{p}</p>)}</div>
      </div>
      <Image class="about-img" src={img('fugas/fugas-04.jpg')} alt={es ? 'Soldador de Solvers trabajando en una tubería' : 'Solvers welder working on a pipeline'} widths={[400, 680]} sizes="(min-width: 900px) 560px, 100vw" />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="vision">
        <p class="eyebrow">{c.visionTitle}</p>
        <blockquote>{c.vision}</blockquote>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><h2>{c.sectorsTitle}</h2></div>
      <div class="grid grid--4">
        {c.sectors.map((s) => (
          <div class="sector">
            <span class="sector__icon"><Icon name={s.icon as any} size={28} /></span>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container split">
      <div>
        <h2>{c.clientsTitle}</h2>
        <p>{c.clientsText}</p>
        <ul class="clients">{SITE.clients.map((n) => <li>{n}</li>)}</ul>
      </div>
      <figure class="letter">
        <h2 class="letter__title">{c.letterTitle}</h2>
        <blockquote><p>{c.letter}</p></blockquote>
        <figcaption><strong>{SITE.president}</strong><span>{c.role}</span></figcaption>
      </figure>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .about-img { width: 100%; border-radius: var(--radius-lg); box-shadow: var(--shadow-2); }
  .vision { max-width: 900px; border-left: 6px solid var(--color-naranja); padding-left: var(--space-6); }
  .vision blockquote { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: var(--fs-600); line-height: 1.3; color: var(--color-azul); }
  .sector { background: #fff; border: 1px solid var(--color-borde); border-top: 4px solid var(--color-naranja); border-radius: var(--radius); padding: var(--space-5); }
  .sector__icon { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: var(--radius); background: var(--color-azul-100); color: var(--color-azul); margin-bottom: var(--space-4); }
  .sector h3 { font-size: 1.45rem; margin-bottom: var(--space-2); }
  .sector p { margin: 0; color: var(--color-texto-suave); }
  .clients { list-style: none; display: grid; gap: var(--space-2); margin-top: var(--space-4); }
  .clients li {
    font-family: var(--font-display); font-weight: 600; font-size: 1.35rem; text-transform: uppercase; letter-spacing: 0.04em; color: #fff;
    padding: var(--space-3) 0; border-bottom: 1px solid rgb(255 255 255 / 0.12);
  }
  .letter { margin: 0; background: var(--color-azul-900); border-radius: var(--radius-lg); padding: var(--space-6); border: 1px solid rgb(255 255 255 / 0.1); }
  .letter__title { font-size: 1.6rem; }
  .letter blockquote { margin: 0 0 var(--space-5); }
  .letter blockquote p { font-size: 1.1rem; color: #dfe5f2; }
  .letter figcaption { display: grid; color: #c4cde0; }
  .letter figcaption strong { color: #fff; font-size: 1.1rem; }
</style>
