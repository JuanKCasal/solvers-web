---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { ROUTES, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';
import { SITE, whatsappUrl } from '../config/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const es = lang === 'es';
const c = es
  ? {
      title: 'Contacto',
      description: 'Contacte a Solvers Industriales, C.A. por WhatsApp, teléfono o correo para solicitar una cotización de servicios de ingeniería, mantenimiento, procura o alquiler de maquinaria.',
      lead: 'Cuéntenos qué necesita. Le responderemos con una propuesta técnica y económica.',
      formTitle: 'Escríbanos',
      direct: 'Contacto directo',
      wa: 'La vía más rápida para coordinar visitas técnicas y cotizaciones.',
      coverage: 'Cobertura',
      coverageText: 'Prestamos servicios en todo el territorio venezolano.',
    }
  : {
      title: 'Contact',
      description: 'Contact Solvers Industriales, C.A. via WhatsApp, phone or email to request a quote for engineering, maintenance, procurement or equipment rental services.',
      lead: 'Tell us what you need. We will reply with a technical and commercial proposal.',
      formTitle: 'Write to us',
      direct: 'Direct contact',
      wa: 'The fastest way to arrange site visits and quotes.',
      coverage: 'Coverage',
      coverageText: 'We provide services throughout Venezuela.',
    };
---
<BaseLayout lang={lang} title={c.title} description={c.description} alternates={ROUTES.contact}>
  <PageHero lang={lang} title={c.title} lead={c.lead} crumbs={[{ label: c.title }]} />

  <section class="section">
    <div class="container contact">
      <div class="contact__form">
        <h2>{c.formTitle}</h2>
        <ContactForm lang={lang} />
      </div>

      <aside class="contact__info" aria-labelledby="contacto-directo">
        <h2 id="contacto-directo">{c.direct}</h2>
        <a class="info-card info-card--wa" href={whatsappUrl(t('cta.whatsappText'))} target="_blank" rel="noopener">
          <Icon name="chat" size={28} />
          <span><strong>WhatsApp</strong><span>{SITE.phones[0].display}</span><small>{c.wa}</small></span>
        </a>
        {SITE.phones.map((p) => (
          <a class="info-card" href={`tel:${p.tel}`}>
            <Icon name="phone" size={26} />
            <span><strong>{t('contact.phone')}</strong><span>{p.display}</span></span>
          </a>
        ))}
        <a class="info-card" href={`mailto:${SITE.email}`}>
          <Icon name="mail" size={26} />
          <span><strong>{t('contact.email')}</strong><span class="break">{SITE.email}</span></span>
        </a>
        <div class="info-card info-card--static">
          <Icon name="map" size={26} />
          <span><strong>{c.coverage}</strong><span>{c.coverageText}</span></span>
        </div>
        <p class="legal">{SITE.legalName}<br />RIF {SITE.rif}</p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; gap: var(--space-7); }
  @media (min-width: 960px) { .contact { grid-template-columns: 1.6fr 1fr; } }
  .contact h2 { font-size: var(--fs-600); }
  .contact__info { display: grid; gap: var(--space-3); align-content: start; }
  .info-card {
    display: flex; align-items: flex-start; gap: var(--space-4); padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-borde); border-radius: var(--radius); text-decoration: none; color: var(--color-texto);
  }
  .info-card :global(svg) { color: var(--color-naranja); flex: none; margin-top: 2px; }
  .info-card > span { display: grid; gap: 2px; min-width: 0; }
  .info-card strong { font-family: var(--font-display); font-size: 1.2rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-tinta); }
  .info-card small { color: var(--color-texto-suave); font-size: var(--fs-300); }
  a.info-card:hover { border-color: var(--color-naranja); }
  .info-card--wa { background: #e9f7ef; border-color: #b9e3c9; }
  .info-card--wa :global(svg) { color: #128c4a; }
  .break { overflow-wrap: anywhere; }
  .legal { margin-top: var(--space-3); font-size: var(--fs-300); color: var(--color-texto-suave); }
</style>
