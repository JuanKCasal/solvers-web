---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { img } from '../data/images';
import { EQUIPMENT, type Equipment } from '../data/equipos';
import { ROUTES, route, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';
import { whatsappUrl } from '../config/site';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useT(lang);
const es = lang === 'es';
const c = es
  ? {
      title: 'Maquinaria y equipos',
      description: 'Alquiler de maquinaria pesada en Venezuela: cargador frontal Volvo L190E, excavadora Volvo EC210BLC, retroexcavadoras Volvo BL60 y BL60B, compactador vibratorio, compresor, soldadoras Lincoln y camión grúa.',
      lead: 'Alquiler de maquinaria pesada y equipos de apoyo para obras, mantenimiento y movimientos de tierra.',
      heavy: 'Maquinaria pesada',
      heavyLead: 'Equipos disponibles para alquiler.',
      support: 'Equipos y vehículos de apoyo',
      supportLead: 'Recursos propios que respaldan nuestros trabajos de campo.',
      ask: 'Consultar disponibilidad',
      waText: 'Hola, quisiera consultar la disponibilidad de maquinaria pesada para alquiler.',
    }
  : {
      title: 'Equipment rental',
      description: 'Heavy equipment rental in Venezuela: Volvo L190E wheel loader, Volvo EC210BLC excavator, Volvo BL60 and BL60B backhoe loaders, vibratory compactor, compressor, Lincoln welders and crane truck.',
      lead: 'Heavy equipment and support equipment rental for construction, maintenance and earthmoving.',
      heavy: 'Heavy equipment',
      heavyLead: 'Equipment available for rent.',
      support: 'Support equipment and vehicles',
      supportLead: 'In-house resources that back our field work.',
      ask: 'Check availability',
      waText: 'Hello, I would like to check heavy equipment rental availability.',
    };
const groups: { key: Equipment['group']; title: string; lead: string }[] = [
  { key: 'heavy', title: c.heavy, lead: c.heavyLead },
  { key: 'support', title: c.support, lead: c.supportLead },
];
---
<BaseLayout lang={lang} title={c.title} description={c.description} alternates={ROUTES.equipment}>
  <PageHero lang={lang} title={c.title} lead={c.lead} crumbs={[{ label: c.title }]} />

  {groups.map((g, gi) => (
    <section class:list={['section', { 'section--alt': gi === 0 }]}>
      <div class="container">
        <div class="section-head">
          <h2>{g.title}</h2>
          <p>{g.lead}</p>
        </div>
        <div class="grid grid--3">
          {EQUIPMENT.filter((e) => e.group === g.key).map((e) => (
            <article class="eq-card">
              <div class:list={['eq-card__media', { 'is-double': e.photos.length > 1 }]}>
                {e.photos.slice(0, 2).map((p, i) => (
                  <Image src={img(p)} alt={`${e.name[lang]}${e.model ? ` ${e.model}` : ''}${i ? ` (${i + 1})` : ''}`}
                    widths={[320, 520]} sizes="(min-width: 1100px) 370px, (min-width: 700px) 45vw, 100vw" loading="lazy" />
                ))}
              </div>
              <div class="eq-card__body">
                <h3>{e.name[lang]}</h3>
                {e.model && <p class="eq-card__model">{e.model}</p>}
              </div>
            </article>
          ))}
        </div>
        {g.key === 'heavy' && (
          <div class="btn-row eq-cta">
            <a class="btn btn--primary" href={route('contact', lang)}>{c.ask} <Icon name="arrow" /></a>
            <a class="btn btn--outline" href={whatsappUrl(c.waText)} target="_blank" rel="noopener"><Icon name="chat" /> WhatsApp</a>
          </div>
        )}
      </div>
    </section>
  ))}

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .eq-card { background: #fff; border: 1px solid var(--color-borde); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-1); }
  .eq-card__media { display: grid; gap: 2px; background: var(--color-borde); }
  .eq-card__media.is-double { grid-template-columns: 1fr 1fr; }
  .eq-card__media :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .eq-card__media:not(.is-double) :global(img) { aspect-ratio: 16 / 10; }
  .eq-card__body { padding: var(--space-4) var(--space-5) var(--space-5); border-top: 4px solid var(--color-naranja); }
  .eq-card h3 { font-size: 1.45rem; margin: 0; }
  .eq-card__model { margin: var(--space-1) 0 0; font-weight: 600; color: var(--color-texto-suave); }
  .eq-cta { margin-top: var(--space-6); }
</style>
