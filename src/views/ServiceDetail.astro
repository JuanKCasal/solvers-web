---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Gallery from '../components/Gallery.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { img } from '../data/images';
import { SERVICES, type Service } from '../data/servicios';
import { projectsByService } from '../data/proyectos';
import { href, route, serviceUrl, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props { lang: Lang; service: Service; }
const { lang, service: s } = Astro.props;
const t = useT(lang);
const es = lang === 'es';
const projects = projectsByService(s.id);
const others = SERVICES.filter((o) => o.id !== s.id);
const alternates = { es: serviceUrl(s.slug, 'es'), en: serviceUrl(s.slug, 'en') };
---
<BaseLayout lang={lang} title={s.title[lang]} description={`${s.summary[lang]} Solvers Industriales, C.A.`} alternates={alternates}>
  <PageHero lang={lang} title={s.title[lang]} lead={s.intro[lang]} eyebrow={t('nav.services')}
    crumbs={[{ label: t('nav.services'), href: route('services', lang) }, { label: s.title[lang] }]} />

  <section class="section">
    <div class="container split split--top">
      <div>
        <h2>{es ? 'Alcance del servicio' : 'Scope of service'}</h2>
        <ul class="checklist">{s.items.map((i) => <li>{i[lang]}</li>)}</ul>
        <div class="btn-row cta-inline">
          <a class="btn btn--primary" href={route('contact', lang)}>{t('cta.quote')} <Icon name="arrow" /></a>
        </div>
      </div>
      <Image class="detail-cover" src={img(s.cover)} alt={s.coverAlt[lang]} widths={[400, 700]} sizes="(min-width: 900px) 560px, 100vw" loading="eager" />
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section section--alt">
      <div class="container">
        <div class="section-head">
          <p class="eyebrow">{es ? 'Trabajos ejecutados' : 'Completed work'}</p>
          <h2>{es ? 'Experiencia comprobada' : 'Proven experience'}</h2>
        </div>
        <div class="projects">
          {projects.map((p) => (
            <article class="project" id={p.id}>
              <div class="project__head">
                {p.client && <p class="project__client">{p.client}</p>}
                <h3>{p.title[lang]}</h3>
                <p>{p.description[lang]}</p>
              </div>
              <Gallery photos={p.photos} lang={lang} id={p.id} max={8} />
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container">
      <h2 class="others-title">{es ? 'Otros servicios' : 'Other services'}</h2>
      <ul class="others">
        {others.map((o) => (
          <li><a href={o.link ? route('equipment', lang) : href(serviceUrl(o.slug, lang))}><Icon name={o.icon} /> {o.title[lang]}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</BaseLayout>

<style>
  .split--top { align-items: start; }
  .detail-cover { width: 100%; border-radius: var(--radius-lg); box-shadow: var(--shadow-2); }
  .cta-inline { margin-top: var(--space-6); }
  .projects { display: grid; gap: var(--space-7); }
  .project { background: #fff; border: 1px solid var(--color-borde); border-radius: var(--radius-lg); padding: var(--space-5); }
  .project__head { max-width: 820px; margin-bottom: var(--space-5); }
  .project__client { margin: 0 0 var(--space-2); font-size: var(--fs-300); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-naranja-texto); }
  .project h3 { font-size: 1.6rem; margin-bottom: var(--space-2); }
  .project__head p:last-child { margin: 0; color: var(--color-texto-suave); }
  .others-title { font-size: var(--fs-600); }
  .others { list-style: none; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .others a {
    display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); min-height: 56px;
    border: 1px solid var(--color-borde); border-radius: var(--radius); text-decoration: none; color: var(--color-tinta); font-weight: 600;
  }
  .others a :global(svg) { color: var(--color-naranja); flex: none; }
  .others a:hover { border-color: var(--color-naranja); color: var(--color-naranja-texto); }
</style>
