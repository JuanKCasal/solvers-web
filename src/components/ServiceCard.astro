---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { img } from '../data/images';
import type { Service } from '../data/servicios';
import { href, route, serviceUrl, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props { service: Service; lang: Lang; }
const { service: s, lang } = Astro.props;
const t = useT(lang);
const url = s.link ? route('equipment', lang) : href(serviceUrl(s.slug, lang));
---
<article class="svc-card">
  <div class="svc-card__media">
    <Image src={img(s.cover)} alt="" widths={[400, 640]} sizes="(min-width: 1100px) 370px, (min-width: 700px) 45vw, 100vw" loading="lazy" />
    <span class="svc-card__icon"><Icon name={s.icon} size={26} /></span>
  </div>
  <div class="svc-card__body">
    <h3><a href={url}>{s.title[lang]}</a></h3>
    <p>{s.summary[lang]}</p>
    <span class="link-arrow" aria-hidden="true">{t('cta.more')} <Icon name="arrow" /></span>
  </div>
</article>

<style>
  .svc-card {
    position: relative; display: flex; flex-direction: column; background: #fff;
    border: 1px solid var(--color-borde); border-radius: var(--radius-lg); overflow: hidden;
    box-shadow: var(--shadow-1); transition: box-shadow .2s, transform .2s;
  }
  .svc-card:hover { box-shadow: var(--shadow-2); transform: translateY(-3px); }
  .svc-card:focus-within { outline: 3px solid var(--color-naranja); outline-offset: 2px; }
  .svc-card__media { position: relative; background: var(--color-azul-100); }
  .svc-card__media :global(img) { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .svc-card__icon {
    position: absolute; left: var(--space-4); bottom: calc(-1 * var(--space-5)); display: grid; place-items: center;
    width: 54px; height: 54px; border-radius: var(--radius); background: var(--color-naranja); color: #fff; box-shadow: var(--shadow-1);
  }
  .svc-card__body { display: flex; flex-direction: column; flex: 1; padding: var(--space-7) var(--space-5) var(--space-5); }
  .svc-card h3 { font-size: 1.6rem; margin-bottom: var(--space-3); }
  .svc-card h3 a { color: inherit; text-decoration: none; }
  .svc-card h3 a::after { content: ''; position: absolute; inset: 0; }
  .svc-card h3 a:focus-visible { outline: none; }
  .svc-card p { color: var(--color-texto-suave); flex: 1; }
</style>
