---
// Galería de fotos con visor (lightbox) accesible basado en <dialog>.
import { Image, getImage } from 'astro:assets';
import { img, type Photo } from '../data/images';
import Icon from './Icon.astro';
import type { Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props { photos: Photo[]; lang: Lang; id: string; max?: number; }
const { photos, lang, id, max } = Astro.props;
const t = useT(lang);
const shown = max ? photos.slice(0, max) : photos;

const items = await Promise.all(
  shown.map(async (p) => {
    const meta = img(p.src);
    const large = await getImage({ src: meta, width: Math.min(meta.width, 1400), format: 'webp' });
    return { meta, alt: p.alt[lang], large: large.src };
  }),
);
---
<div class="gallery" data-gallery={id}>
  <ul class="gallery__grid">
    {items.map((it, i) => (
      <li>
        <button type="button" class="gallery__item" data-index={i} data-src={it.large} data-alt={it.alt}>
          <Image src={it.meta} alt={it.alt} widths={[240, 400]} sizes="(min-width: 900px) 260px, 45vw" loading="lazy" />
          <span class="visually-hidden">{t('gallery.open')}</span>
        </button>
      </li>
    ))}
  </ul>

  <dialog class="lightbox" aria-label={t('gallery.open')}>
    <div class="lightbox__frame">
      <img class="lightbox__img" src="" alt="" />
      <p class="lightbox__caption"></p>
    </div>
    <button type="button" class="lightbox__btn lightbox__close" aria-label={t('gallery.close')}><Icon name="close" /></button>
    {items.length > 1 && (
      <>
        <button type="button" class="lightbox__btn lightbox__prev" aria-label={t('gallery.prev')}><Icon name="chevron-left" /></button>
        <button type="button" class="lightbox__btn lightbox__next" aria-label={t('gallery.next')}><Icon name="chevron-right" /></button>
      </>
    )}
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const dialog = root.querySelector('dialog')!;
    const image = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const caption = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('.gallery__item'));
    let index = 0;
    const show = (i: number) => {
      index = (i + buttons.length) % buttons.length;
      const b = buttons[index];
      image.src = b.dataset.src!;
      image.alt = b.dataset.alt!;
      caption.textContent = `${b.dataset.alt}`;
    };
    buttons.forEach((b, i) => b.addEventListener('click', () => { show(i); dialog.showModal(); }));
    dialog.querySelector('.lightbox__close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lightbox__prev')?.addEventListener('click', () => show(index - 1));
    dialog.querySelector('.lightbox__next')?.addEventListener('click', () => show(index + 1));
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    dialog.addEventListener('close', () => buttons[index]?.focus());
  });
</script>

<style>
  .gallery__grid { list-style: none; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(min(46%, 180px), 1fr)); }
  .gallery__item {
    display: block; width: 100%; padding: 0; border: 0; border-radius: var(--radius); overflow: hidden; cursor: zoom-in;
    aspect-ratio: 4 / 3; background: var(--color-azul-100);
  }
  .gallery__item :global(img) { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform .25s; }
  .gallery__item:hover :global(img) { transform: scale(1.04); }

  .lightbox {
    width: min(96vw, 1100px); max-width: none; max-height: 94vh; padding: 0; border: 0; background: transparent; overflow: visible;
  }
  .lightbox::backdrop { background: rgb(0 10 30 / 0.88); }
  .lightbox__frame { display: grid; justify-items: center; gap: var(--space-3); }
  .lightbox__img { max-width: 100%; max-height: 80vh; width: auto; height: auto; border-radius: var(--radius); background: #fff; }
  .lightbox__caption { margin: 0; color: #fff; text-align: center; font-size: 1rem; }
  .lightbox__btn {
    position: fixed; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 0;
    background: rgb(255 255 255 / 0.95); color: var(--color-azul); cursor: pointer; box-shadow: var(--shadow-2);
  }
  .lightbox__btn:hover { background: var(--color-naranja); color: #fff; }
  .lightbox__close { top: 16px; right: 16px; }
  .lightbox__prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: 16px; top: 50%; transform: translateY(-50%); }
</style>
