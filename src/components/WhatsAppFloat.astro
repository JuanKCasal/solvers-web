---
import Icon from './Icon.astro';
import { whatsappUrl } from '../config/site';
import { useT } from '../i18n/ui';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang; }
const t = useT(Astro.props.lang);
---
<a class="wa-float" href={whatsappUrl(t('cta.whatsappText'))} target="_blank" rel="noopener" aria-label={t('cta.whatsappFloat')}>
  <Icon name="chat" size={30} />
  <span class="wa-float__label">WhatsApp</span>
</a>

<style>
  .wa-float {
    position: fixed; right: max(16px, env(safe-area-inset-right)); bottom: max(16px, env(safe-area-inset-bottom)); z-index: 40;
    display: inline-flex; align-items: center; gap: var(--space-2);
    height: 56px; padding: 0 14px; border-radius: 999px;
    background: #0e7a40; color: #fff; text-decoration: none; font-weight: 700;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.25); transition: transform .15s, background-color .15s;
  }
  .wa-float:hover { background: #0b6334; color: #fff; transform: translateY(-2px); }
  .wa-float__label { display: none; }
  @media (min-width: 720px) { .wa-float { padding: 0 20px 0 14px; } .wa-float__label { display: inline; } }
  :global(body.nav-open) .wa-float { display: none; }
</style>
