---
import { route, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  eyebrow?: string;
  crumbs?: { label: string; href?: string }[];
}
const { lang, title, lead, eyebrow, crumbs = [] } = Astro.props;
const t = useT(lang);
const trail = [{ label: t('nav.home'), href: route('home', lang) }, ...crumbs];
---
<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label={t('breadcrumb')}>
      <ol>
        {trail.map((c, i) => (
          <li>
            {c.href && i < trail.length - 1
              ? <a href={c.href}>{c.label}</a>
              : <span aria-current="page">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
  </div>
  <span class="page-hero__bar" aria-hidden="true"></span>
</section>
