---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ROUTES, route } from '../i18n/routes';
---
<BaseLayout lang="es" title="Página no encontrada" alternates={ROUTES.home} noindex>
  <section class="section nf">
    <div class="container">
      <p class="nf__code" aria-hidden="true">404</p>
      <h1>Página no encontrada</h1>
      <p>La página que busca no existe o fue movida.</p>
      <p lang="en">Page not found. The page you are looking for does not exist or has moved.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={route('home', 'es')}>Ir al inicio</a>
        <a class="btn btn--outline" href={route('home', 'en')} lang="en">Go to home page</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf { min-height: 50vh; }
  .nf__code { font-family: var(--font-display); font-weight: 700; font-size: 7rem; line-height: 1; color: var(--color-naranja); margin: 0 0 var(--space-4); }
  .nf p { font-size: 1.15rem; }
</style>
