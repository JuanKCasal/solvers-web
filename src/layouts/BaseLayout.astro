---
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { href, type Alternates, type Lang } from '../i18n/routes';
import { useT } from '../i18n/ui';
import { SITE } from '../config/site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  alternates: Alternates;
  noindex?: boolean;
}

const { lang, title, description, alternates, noindex = false } = Astro.props;
const t = useT(lang);
const desc = description ?? t('meta.defaultDescription');
const fullTitle = title === SITE.name ? `${SITE.legalName}` : `${title} | ${SITE.name}`;

const abs = (path: string) => new URL(href(path), Astro.site).href;
const canonical = abs(alternates[lang]);
const ogImage = abs('/og-image.jpg');

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  legalName: SITE.legalName,
  url: abs('/'),
  logo: abs('/logo-solvers.png'),
  email: SITE.email,
  telephone: SITE.phones.map((p) => p.tel),
  taxID: SITE.rif,
  areaServed: { '@type': 'Country', name: 'Venezuela' },
  contactPoint: SITE.phones.map((p) => ({
    '@type': 'ContactPoint',
    telephone: p.tel,
    contactType: 'customer service',
    areaServed: 'VE',
    availableLanguage: ['Spanish', 'English'],
  })),
};
---
<!doctype html>
<html lang={lang === 'es' ? 'es' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={abs(alternates.es)} />
    <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
    <link rel="alternate" hreflang="x-default" href={abs(alternates.es)} />

    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('/favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#001b50" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.legalName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t('meta.ogLocale')} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t('skip')}</a>
    <Header lang={lang} alternates={alternates} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFloat lang={lang} />
  </body>
</html>
